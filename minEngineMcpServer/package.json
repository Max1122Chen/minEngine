{
  "name": "minengine-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "minEngine MCP Server — thin stdio adapter to Maximum Automation Host",
  "type": "module",
  "bin": {
    "minengine-mcp-server": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "smoke:ping": "tsx scripts/smoke_ping.ts",
    "smoke:attach": "tsx scripts/smoke_attach.ts",
    "smoke:spawn": "tsx scripts/smoke_spawn.ts",
    "accept:mcp": "tsx scripts/accept_mcp_path.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
