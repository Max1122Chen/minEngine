// Split-sum IBL for metallic-roughness PBR (LearnOpenGL-style).
// Requires MaterialPBR.glslinc included earlier in the same translation unit.
#ifndef MINENGINE_MATERIAL_IBL_GLSLINC
#define MINENGINE_MATERIAL_IBL_GLSLINC

// 512-face env cubemap → log2(512) mips; use highest mip index for roughness=1.
const float kMaterialPBRMaxReflectionLod = 7.0;

uniform float u_EnvIntensity;

vec3 MaterialPBRFresnelSchlickRoughness(float cosTheta, vec3 F0, float roughness)
{
    return F0 + (max(vec3(1.0 - roughness), F0) - F0) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
}

// Filament-style split-sum BRDF approximation when no offline LUT is bound yet.
vec2 MaterialPBRIntegrateBrdfApprox(float NdotV, float roughness)
{
    const vec4 c0 = vec4(-1.0, -0.0275, -0.572, 0.022);
    const vec4 c1 = vec4(1.0, 0.0425, 1.04, -0.04);
    vec4 r = roughness * c0 + c1;
    float a004 = min(r.x * r.x, exp2(-9.28 * NdotV)) * r.x + r.y;
    return vec2(-1.04, 1.04) * a004 + r.zw;
}

vec3 CalcIndirectPBR(
    vec3 N,
    vec3 V,
    vec3 albedo,
    float metallic,
    float roughness,
    float ao,
    samplerCube irradianceMap,
    samplerCube prefilterMap,
    sampler2D brdfLUT)
{
    N = normalize(N);
    V = normalize(V);
    float NdotV = max(dot(N, V), 0.0);

    vec3 F0 = vec3(0.04);
    F0 = mix(F0, albedo, metallic);

    vec3 kS = MaterialPBRFresnelSchlickRoughness(NdotV, F0, roughness);
    vec3 kD = (vec3(1.0) - kS) * (1.0 - metallic);

    vec3 diffuseIBL = texture(irradianceMap, N).rgb * albedo;

    vec3 R = reflect(-V, N);
    vec3 prefilteredColor = textureLod(prefilterMap, R, roughness * kMaterialPBRMaxReflectionLod).rgb;

    vec2 brdf = texture(brdfLUT, vec2(NdotV, roughness)).rg;
    float brdfEnergy = brdf.x + brdf.y;
    if (brdfEnergy < 0.0001)
    {
        brdf = MaterialPBRIntegrateBrdfApprox(NdotV, roughness);
    }

    vec3 specularIBL = prefilteredColor * (kS * brdf.x + brdf.y);

    return (kD * diffuseIBL + specularIBL) * ao * u_EnvIntensity;
}

#endif // MINENGINE_MATERIAL_IBL_GLSLINC
