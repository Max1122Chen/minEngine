// Shared shadow sampling for graph material templates (extracted from legacy Phong.frag).
#ifndef MINENGINE_MATERIAL_SCENE_SHADOWS_GLSLINC
#define MINENGINE_MATERIAL_SCENE_SHADOWS_GLSLINC

// Prefer inject from ShaderCompiler (EngineRenderLimits). Fallbacks for IDE / non-injected paths.
#ifndef MAX_SPOT_SHADOW_MAPS
#define MAX_SPOT_SHADOW_MAPS 2
#endif
#ifndef MAX_POINT_SHADOW_MAPS
#define MAX_POINT_SHADOW_MAPS 2
#endif
#ifndef SPOT_SHADOW_SAMPLER_SLOTS
#define SPOT_SHADOW_SAMPLER_SLOTS 2
#endif
#ifndef POINT_SHADOW_SAMPLER_SLOTS
#define POINT_SHADOW_SAMPLER_SLOTS 2
#endif

#define SHADOW_FILTER_BOX 0
#define SHADOW_FILTER_POISSON 1
#define SHADOW_FILTER_POISSON_PCSS 2

#ifndef DIR_SHADOW_FILTER
#define DIR_SHADOW_FILTER SHADOW_FILTER_POISSON
#endif

#ifndef SPOT_SHADOW_FILTER
#define SPOT_SHADOW_FILTER SHADOW_FILTER_POISSON
#endif

#ifndef POINT_SHADOW_FILTER
#define POINT_SHADOW_FILTER SHADOW_FILTER_POISSON
#endif

#ifndef POISSON_SAMPLE_COUNT
#define POISSON_SAMPLE_COUNT 16
#endif

struct DirectionalLightData
{
    vec4 Direction;
    vec4 Color;     // w for intensity
    vec4 Params;    // w for shadow map index
};

struct PointLightData
{
    vec4 Position;  // w for radius
    vec4 Color;     // w for intensity
    vec4 Params;    // w for shadow map index
};

struct SpotLightData
{
    vec4 Direction;
    vec4 Position;
    vec4 Color;      // w for intensity
    vec4 Params;     // x=inner, y=outer, w=shadow map index
};
layout (std140, set = 0, binding = 1) uniform LightsData
{
    DirectionalLightData DirectionalLight;
    PointLightData PointLights[16];
    SpotLightData SpotLights[16];
    uint PointLightsCount;
    uint SpotLightsCount;
};

layout (std140, set = 1, binding = 1) uniform DirLightViewProjs
{
    mat4 DirLightViewProj[4];
};

layout (std140, set = 1, binding = 3) uniform SpotLightViewProjs
{
    mat4 SpotLightViewProj[16];
};

layout (std140, set = 1, binding = 2) uniform CascadeFarPlanes
{
    float FarPlanes[4];
};

// Shadow maps (set 1 matches EngineSceneBindingSets / EngineShaderBindings).
layout (set = 1, binding = 0) uniform sampler2DArray u_DirLightShadowMap;
layout (set = 1, binding = 4) uniform sampler2D u_SpotShadowMap0;
layout (set = 1, binding = 5) uniform sampler2D u_SpotShadowMap1;
layout (set = 1, binding = 6) uniform samplerCube u_PointShadowMap0;
layout (set = 1, binding = 7) uniform samplerCube u_PointShadowMap1;
const int kMaxPoissonSamples = 16;
const int kPoissonSampleCount = (POISSON_SAMPLE_COUNT <= kMaxPoissonSamples) ? POISSON_SAMPLE_COUNT : kMaxPoissonSamples;
const float kDirBoxRadius = 1.0;
const float kSpotBoxRadius = 1.0;
const float kDirPoissonRadius = 2.0;
const float kSpotPoissonRadius = 2.0;
const float kPointBoxRadius = 0.04;
const float kPointPoissonRadius = 0.05;
const float kDirPcssSearchRadius = 3.0;
const float kSpotPcssSearchRadius = 3.0;
const float kDirPcssLightSize = 20.0;
const float kSpotPcssLightSize = 20.0;
const float kDirPcssMaxRadius = 12.0;
const float kSpotPcssMaxRadius = 12.0;
const float kPointPcssScale = 0.15;
const float kPointPcssMaxRadius = 0.2;

const vec2 kPoissonDisk[kMaxPoissonSamples] = vec2[](
    vec2(-0.94201624, -0.39906216),
    vec2(0.94558609, -0.76890725),
    vec2(-0.09418410, -0.92938870),
    vec2(0.34495938, 0.29387760),
    vec2(-0.91588581, 0.45771432),
    vec2(-0.81544232, -0.87912464),
    vec2(-0.38277543, 0.27676845),
    vec2(0.97484398, 0.75648379),
    vec2(0.44323325, -0.97511554),
    vec2(0.53742981, -0.47373420),
    vec2(-0.26496911, -0.41893023),
    vec2(0.79197514, 0.19090188),
    vec2(-0.24188840, 0.99706507),
    vec2(-0.81409955, 0.91437590),
    vec2(0.19984126, 0.78641367),
    vec2(0.14383161, -0.14100790)
);

float Hash12(vec2 p)
{
    return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453123);
}

vec2 Rotate2D(vec2 v, float angle)
{
    float s = sin(angle);
    float c = cos(angle);
    return vec2(c * v.x - s * v.y, s * v.x + c * v.y);
}

// Params.w < 0 means no shadow (CPU sentinel -1). Do not round with +0.5: int(-0.5)==0 in GLSL.
int MinEngineShadowMapSlot(float paramsW)
{
    if (paramsW < 0.0)
    {
        return -1;
    }
    return int(paramsW + 0.5);
}

// Layer C: NDC → shadow UV + compare depth (Dir/Spot projected shadows only).
// Z: OpenGL N1 needs *0.5+0.5; Vulkan ZO uses ndc.z directly.
vec3 MinEngineShadowMapCoords(vec4 fragPosLightSpace)
{
    vec3 ndc = fragPosLightSpace.xyz / fragPosLightSpace.w;
    vec2 uv = ndc.xy * 0.5 + 0.5;
#if defined(MINENGINE_CLIP_DEPTH_ZERO_TO_ONE) && (MINENGINE_CLIP_DEPTH_ZERO_TO_ONE != 0)
    float depth = ndc.z;
#else
    float depth = ndc.z * 0.5 + 0.5;
#endif
    return vec3(uv, depth);
}

// Directional shadow debug (toggle via ShaderCompiler inject or #define before include).
// 0 off | 1 cascade colors | 2 single-tap shadow | 3 UV.xy | 4 current depth | 5 sampled depth | 6 depth delta
#ifndef DIR_SHADOW_DEBUG_MODE
#define DIR_SHADOW_DEBUG_MODE 0
#endif

// Force a single cascade for experiments: -1 = normal selection, 0..3 = always use that layer.
#ifndef DIR_SHADOW_FORCE_CASCADE
#define DIR_SHADOW_FORCE_CASCADE -1
#endif

int SelectDirectionalCascadeIndex(float viewDepth)
{
#if DIR_SHADOW_FORCE_CASCADE >= 0
    return DIR_SHADOW_FORCE_CASCADE;
#else
    for (int i = 0; i < 4; ++i)
    {
        if (viewDepth < FarPlanes[i])
        {
            return i;
        }
    }
    return 3;
#endif
}

bool DirShadowProjCoordsInBounds(vec3 projCoords)
{
    return projCoords.x >= 0.0 && projCoords.x <= 1.0 &&
           projCoords.y >= 0.0 && projCoords.y <= 1.0 &&
           projCoords.z >= 0.0 && projCoords.z <= 1.0;
}

float SampleDirShadowSingleTap(vec4 fragPosLightSpace, float shadowLayer, float bias)
{
    vec3 projCoords = MinEngineShadowMapCoords(fragPosLightSpace);
    if (!DirShadowProjCoordsInBounds(projCoords))
    {
        return 0.0;
    }

    float sampledDepth = texture(u_DirLightShadowMap, vec3(projCoords.xy, shadowLayer)).r;
    float currentDepth = projCoords.z;
    return (currentDepth - bias > sampledDepth) ? 1.0 : 0.0;
}

vec3 GetCascadeDebugColor(int cascadeIndex);

// Returns true when debug visualization replaces lighting for the directional pass.
bool TryDirShadowDebugVisual(vec3 fragPos, vec4 fragPosViewSpace, out vec3 outColor)
{
#if DIR_SHADOW_DEBUG_MODE == 0
    return false;
#else
    float viewDepth = -fragPosViewSpace.z;
    int cascadeIndex = SelectDirectionalCascadeIndex(viewDepth);
    vec4 cascadeLightSpacePos = DirLightViewProj[cascadeIndex] * vec4(fragPos, 1.0);
    float shadowLayer = float(cascadeIndex);
    vec3 projCoords = MinEngineShadowMapCoords(cascadeLightSpacePos);
    const vec3 kOutOfBoundsColor = vec3(1.0, 0.0, 1.0);

#if DIR_SHADOW_DEBUG_MODE == 1
    outColor = GetCascadeDebugColor(cascadeIndex);
    return true;
#elif DIR_SHADOW_DEBUG_MODE == 2
    outColor = vec3(SampleDirShadowSingleTap(cascadeLightSpacePos, shadowLayer, 0.0));
    return true;
#elif DIR_SHADOW_DEBUG_MODE == 3
    outColor = DirShadowProjCoordsInBounds(projCoords) ? vec3(projCoords.xy, 0.0) : kOutOfBoundsColor;
    return true;
#elif DIR_SHADOW_DEBUG_MODE == 4
    outColor = DirShadowProjCoordsInBounds(projCoords)
        ? vec3(projCoords.z)
        : kOutOfBoundsColor;
    return true;
#elif DIR_SHADOW_DEBUG_MODE == 5
    if (!DirShadowProjCoordsInBounds(projCoords))
    {
        outColor = kOutOfBoundsColor;
        return true;
    }
    float sampledDepth = texture(u_DirLightShadowMap, vec3(projCoords.xy, shadowLayer)).r;
    outColor = vec3(sampledDepth);
    return true;
#elif DIR_SHADOW_DEBUG_MODE == 6
    if (!DirShadowProjCoordsInBounds(projCoords))
    {
        outColor = kOutOfBoundsColor;
        return true;
    }
    float sampledDepth = texture(u_DirLightShadowMap, vec3(projCoords.xy, shadowLayer)).r;
    float delta = projCoords.z - sampledDepth;
    outColor = vec3(clamp(delta * 10.0 + 0.5, 0.0, 1.0));
    return true;
#else
    return false;
#endif
#endif
}

void BuildPointShadowBasis(vec3 dir, out vec3 tangent, out vec3 bitangent)
{
    vec3 up = abs(dir.y) > 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(0.0, 1.0, 0.0);
    tangent = normalize(cross(up, dir));
    bitangent = cross(dir, tangent);
}

float SampleDirShadowPCF(vec4 fragPosLightSpace, float shadowLayer, float bias);
float SampleDirShadowPCF_Box(vec4 fragPosLightSpace, float shadowLayer, float bias);
float SampleDirShadowPCF_Poisson(vec4 fragPosLightSpace, float shadowLayer, float bias);
float SampleDirShadowPCF_PoissonPCSS(vec4 fragPosLightSpace, float shadowLayer, float bias);

float SampleSpotShadowPCF(vec4 fragPosLightSpace, int shadowIndex, float bias);
float SampleSpotShadowPCF_Box(vec4 fragPosLightSpace, int shadowIndex, float bias);
float SampleSpotShadowPCF_Poisson(vec4 fragPosLightSpace, int shadowIndex, float bias);
float SampleSpotShadowPCF_PoissonPCSS(vec4 fragPosLightSpace, int shadowIndex, float bias);

float SamplePointShadowPCF(vec3 fragPos, vec3 lightPos, float farPlane, int shadowIndex, float bias);
float SamplePointShadowPCF_Box(vec3 fragPos, vec3 lightPos, float farPlane, int shadowIndex, float bias);
float SamplePointShadowPCF_Poisson(vec3 fragPos, vec3 lightPos, float farPlane, int shadowIndex, float bias);
float SamplePointShadowPCF_PoissonPCSS(vec3 fragPos, vec3 lightPos, float farPlane, int shadowIndex, float bias);

float SampleDirShadowPCF(vec4 fragPosLightSpace, float shadowLayer, float bias)
{
#if DIR_SHADOW_FILTER == SHADOW_FILTER_BOX
    return SampleDirShadowPCF_Box(fragPosLightSpace, shadowLayer, bias);
#elif DIR_SHADOW_FILTER == SHADOW_FILTER_POISSON
    return SampleDirShadowPCF_Poisson(fragPosLightSpace, shadowLayer, bias);
#elif DIR_SHADOW_FILTER == SHADOW_FILTER_POISSON_PCSS
    return SampleDirShadowPCF_PoissonPCSS(fragPosLightSpace, shadowLayer, bias);
#else
    return SampleDirShadowPCF_Box(fragPosLightSpace, shadowLayer, bias);
#endif
}

float SampleDirShadowPCF_Box(vec4 fragPosLightSpace, float shadowLayer, float bias)
{
    vec3 projCoords = MinEngineShadowMapCoords(fragPosLightSpace);

    if(projCoords.x < 0.0 || projCoords.x > 1.0 ||
       projCoords.y < 0.0 || projCoords.y > 1.0 ||
       projCoords.z < 0.0 || projCoords.z > 1.0)
    {
        return 0.0;
    }

    vec2 texelSize = 1.0 / vec2(textureSize(u_DirLightShadowMap, 0).xy);
    float currentDepth = projCoords.z;

    float shadow = 0.0;
    for(int x = -1; x <= 1; ++x)
    {
        for(int y = -1; y <= 1; ++y)
        {
            vec2 offset = vec2(float(x), float(y)) * texelSize * kDirBoxRadius;
            vec2 sampleUV = clamp(projCoords.xy + offset, 0.0, 1.0);
            float sampledDepth = texture(u_DirLightShadowMap, vec3(sampleUV, shadowLayer)).r;
            shadow += (currentDepth - bias > sampledDepth) ? 1.0 : 0.0;
        }
    }

    return shadow / 9.0;
}

float SampleDirShadowPCF_Poisson(vec4 fragPosLightSpace, float shadowLayer, float bias)
{
    vec3 projCoords = MinEngineShadowMapCoords(fragPosLightSpace);

    if(projCoords.x < 0.0 || projCoords.x > 1.0 ||
       projCoords.y < 0.0 || projCoords.y > 1.0 ||
       projCoords.z < 0.0 || projCoords.z > 1.0)
    {
        return 0.0;
    }

    vec2 texelSize = 1.0 / vec2(textureSize(u_DirLightShadowMap, 0).xy);
    float currentDepth = projCoords.z;
    float angle = Hash12(projCoords.xy * 4096.0) * 6.2831853;

    float shadow = 0.0;
    for(int i = 0; i < kPoissonSampleCount; ++i)
    {
        vec2 offset = Rotate2D(kPoissonDisk[i], angle) * texelSize * kDirPoissonRadius;
        vec2 sampleUV = clamp(projCoords.xy + offset, 0.0, 1.0);
        float sampledDepth = texture(u_DirLightShadowMap, vec3(sampleUV, shadowLayer)).r;
        shadow += (currentDepth - bias > sampledDepth) ? 1.0 : 0.0;
    }

    return shadow / float(kPoissonSampleCount);
}

float SampleDirShadowPCF_PoissonPCSS(vec4 fragPosLightSpace, float shadowLayer, float bias)
{
    vec3 projCoords = MinEngineShadowMapCoords(fragPosLightSpace);

    if(projCoords.x < 0.0 || projCoords.x > 1.0 ||
       projCoords.y < 0.0 || projCoords.y > 1.0 ||
       projCoords.z < 0.0 || projCoords.z > 1.0)
    {
        return 0.0;
    }

    vec2 texelSize = 1.0 / vec2(textureSize(u_DirLightShadowMap, 0).xy);
    float currentDepth = projCoords.z;
    float angle = Hash12(projCoords.xy * 4096.0) * 6.2831853;

    // PCSS step 1: blocker search.
    float blockerDepthSum = 0.0;
    float blockerCount = 0.0;
    for(int i = 0; i < kPoissonSampleCount; ++i)
    {
        vec2 offset = Rotate2D(kPoissonDisk[i], angle) * texelSize * kDirPcssSearchRadius;
        vec2 sampleUV = clamp(projCoords.xy + offset, 0.0, 1.0);
        float sampledDepth = texture(u_DirLightShadowMap, vec3(sampleUV, shadowLayer)).r;
        if (currentDepth - bias > sampledDepth)
        {
            blockerDepthSum += sampledDepth;
            blockerCount += 1.0;
        }
    }

    if (blockerCount <= 0.0)
    {
        return 0.0;
    }

    float avgBlockerDepth = blockerDepthSum / blockerCount;
    float penumbra = (currentDepth - avgBlockerDepth) / max(avgBlockerDepth, 0.0001) * kDirPcssLightSize;
    float filterRadius = clamp(penumbra, kDirPoissonRadius, kDirPcssMaxRadius);

    // PCSS step 2: filter with penumbra radius.
    float shadow = 0.0;
    for(int i = 0; i < kPoissonSampleCount; ++i)
    {
        vec2 offset = Rotate2D(kPoissonDisk[i], angle) * texelSize * filterRadius;
        vec2 sampleUV = clamp(projCoords.xy + offset, 0.0, 1.0);
        float sampledDepth = texture(u_DirLightShadowMap, vec3(sampleUV, shadowLayer)).r;
        shadow += (currentDepth - bias > sampledDepth) ? 1.0 : 0.0;
    }

    return shadow / float(kPoissonSampleCount);
}

float SampleSpotShadowPCF(vec4 fragPosLightSpace, int shadowIndex, float bias)
{
#if SPOT_SHADOW_FILTER == SHADOW_FILTER_BOX
    return SampleSpotShadowPCF_Box(fragPosLightSpace, shadowIndex, bias);
#elif SPOT_SHADOW_FILTER == SHADOW_FILTER_POISSON
    return SampleSpotShadowPCF_Poisson(fragPosLightSpace, shadowIndex, bias);
#elif SPOT_SHADOW_FILTER == SHADOW_FILTER_POISSON_PCSS
    return SampleSpotShadowPCF_PoissonPCSS(fragPosLightSpace, shadowIndex, bias);
#else
    return SampleSpotShadowPCF_Box(fragPosLightSpace, shadowIndex, bias);
#endif
}

float SampleSpotShadowPCF_BoxForMap(vec4 fragPosLightSpace, sampler2D shadowMap, float bias)
{
    vec3 projCoords = MinEngineShadowMapCoords(fragPosLightSpace);

    if(projCoords.x < 0.0 || projCoords.x > 1.0 ||
       projCoords.y < 0.0 || projCoords.y > 1.0 ||
       projCoords.z < 0.0 || projCoords.z > 1.0)
    {
        return 0.0;
    }

    vec2 texelSize = 1.0 / vec2(textureSize(shadowMap, 0));
    float currentDepth = projCoords.z;

    float shadow = 0.0;
    for(int x = -1; x <= 1; ++x)
    {
        for(int y = -1; y <= 1; ++y)
        {
            vec2 offset = vec2(float(x), float(y)) * texelSize * kSpotBoxRadius;
            vec2 sampleUV = clamp(projCoords.xy + offset, 0.0, 1.0);
            float sampledDepth = texture(shadowMap, sampleUV).r;
            shadow += (currentDepth - bias > sampledDepth) ? 1.0 : 0.0;
        }
    }

    return shadow / 9.0;
}

float SampleSpotShadowPCF_Box(vec4 fragPosLightSpace, int shadowIndex, float bias)
{
    if (shadowIndex == 0)
    {
        return SampleSpotShadowPCF_BoxForMap(fragPosLightSpace, u_SpotShadowMap0, bias);
    }
    return SampleSpotShadowPCF_BoxForMap(fragPosLightSpace, u_SpotShadowMap1, bias);
}

float SampleSpotShadowPCF_PoissonForMap(vec4 fragPosLightSpace, sampler2D shadowMap, float bias)
{
    vec3 projCoords = MinEngineShadowMapCoords(fragPosLightSpace);

    if(projCoords.x < 0.0 || projCoords.x > 1.0 ||
       projCoords.y < 0.0 || projCoords.y > 1.0 ||
       projCoords.z < 0.0 || projCoords.z > 1.0)
    {
        return 0.0;
    }

    vec2 texelSize = 1.0 / vec2(textureSize(shadowMap, 0));
    float currentDepth = projCoords.z;
    float angle = Hash12(projCoords.xy * 4096.0) * 6.2831853;

    float shadow = 0.0;
    for(int i = 0; i < kPoissonSampleCount; ++i)
    {
        vec2 offset = Rotate2D(kPoissonDisk[i], angle) * texelSize * kSpotPoissonRadius;
        vec2 sampleUV = clamp(projCoords.xy + offset, 0.0, 1.0);
        float sampledDepth = texture(shadowMap, sampleUV).r;
        shadow += (currentDepth - bias > sampledDepth) ? 1.0 : 0.0;
    }

    return shadow / float(kPoissonSampleCount);
}

float SampleSpotShadowPCF_Poisson(vec4 fragPosLightSpace, int shadowIndex, float bias)
{
    if (shadowIndex == 0)
    {
        return SampleSpotShadowPCF_PoissonForMap(fragPosLightSpace, u_SpotShadowMap0, bias);
    }
    return SampleSpotShadowPCF_PoissonForMap(fragPosLightSpace, u_SpotShadowMap1, bias);
}

float SampleSpotShadowPCF_PoissonPCSSForMap(vec4 fragPosLightSpace, sampler2D shadowMap, float bias)
{
    vec3 projCoords = MinEngineShadowMapCoords(fragPosLightSpace);

    if(projCoords.x < 0.0 || projCoords.x > 1.0 ||
       projCoords.y < 0.0 || projCoords.y > 1.0 ||
       projCoords.z < 0.0 || projCoords.z > 1.0)
    {
        return 0.0;
    }

    vec2 texelSize = 1.0 / vec2(textureSize(shadowMap, 0));
    float currentDepth = projCoords.z;
    float angle = Hash12(projCoords.xy * 4096.0) * 6.2831853;

    float blockerDepthSum = 0.0;
    float blockerCount = 0.0;
    for(int i = 0; i < kPoissonSampleCount; ++i)
    {
        vec2 offset = Rotate2D(kPoissonDisk[i], angle) * texelSize * kSpotPcssSearchRadius;
        vec2 sampleUV = clamp(projCoords.xy + offset, 0.0, 1.0);
        float sampledDepth = texture(shadowMap, sampleUV).r;
        if (currentDepth - bias > sampledDepth)
        {
            blockerDepthSum += sampledDepth;
            blockerCount += 1.0;
        }
    }

    if (blockerCount <= 0.0)
    {
        return 0.0;
    }

    float avgBlockerDepth = blockerDepthSum / blockerCount;
    float penumbra = (currentDepth - avgBlockerDepth) / max(avgBlockerDepth, 0.0001) * kSpotPcssLightSize;
    float filterRadius = clamp(penumbra, kSpotPoissonRadius, kSpotPcssMaxRadius);

    float shadow = 0.0;
    for(int i = 0; i < kPoissonSampleCount; ++i)
    {
        vec2 offset = Rotate2D(kPoissonDisk[i], angle) * texelSize * filterRadius;
        vec2 sampleUV = clamp(projCoords.xy + offset, 0.0, 1.0);
        float sampledDepth = texture(shadowMap, sampleUV).r;
        shadow += (currentDepth - bias > sampledDepth) ? 1.0 : 0.0;
    }

    return shadow / float(kPoissonSampleCount);
}

float SampleSpotShadowPCF_PoissonPCSS(vec4 fragPosLightSpace, int shadowIndex, float bias)
{
    if (shadowIndex == 0)
    {
        return SampleSpotShadowPCF_PoissonPCSSForMap(fragPosLightSpace, u_SpotShadowMap0, bias);
    }
    return SampleSpotShadowPCF_PoissonPCSSForMap(fragPosLightSpace, u_SpotShadowMap1, bias);
}

float SamplePointShadowPCF(vec3 fragPos, vec3 lightPos, float farPlane, int shadowIndex, float bias)
{
#if POINT_SHADOW_FILTER == SHADOW_FILTER_BOX
    return SamplePointShadowPCF_Box(fragPos, lightPos, farPlane, shadowIndex, bias);
#elif POINT_SHADOW_FILTER == SHADOW_FILTER_POISSON
    return SamplePointShadowPCF_Poisson(fragPos, lightPos, farPlane, shadowIndex, bias);
#elif POINT_SHADOW_FILTER == SHADOW_FILTER_POISSON_PCSS
    return SamplePointShadowPCF_PoissonPCSS(fragPos, lightPos, farPlane, shadowIndex, bias);
#else
    return SamplePointShadowPCF_Box(fragPos, lightPos, farPlane, shadowIndex, bias);
#endif
}

float SamplePointShadowPCF_BoxForMap(
    vec3 fragPos,
    vec3 lightPos,
    float farPlane,
    samplerCube shadowMap,
    float bias)
{
    vec3 fragToLight = fragPos - lightPos;
    float currentDepth = length(fragToLight) / farPlane;
    vec3 dir = normalize(fragToLight);

    vec3 tangent;
    vec3 bitangent;
    BuildPointShadowBasis(dir, tangent, bitangent);

    float shadow = 0.0;
    float samples = 0.0;
    for(int x = -1; x <= 1; ++x)
    {
        for(int y = -1; y <= 1; ++y)
        {
            vec2 offset = vec2(float(x), float(y)) * kPointBoxRadius;
            vec3 sampleDir = normalize(dir + tangent * offset.x + bitangent * offset.y);
            float sampledDepth = texture(shadowMap, sampleDir).r;
            shadow += (currentDepth - bias > sampledDepth) ? 1.0 : 0.0;
            samples += 1.0;
        }
    }

    return shadow / samples;
}

float SamplePointShadowPCF_Box(vec3 fragPos, vec3 lightPos, float farPlane, int shadowIndex, float bias)
{
    if (shadowIndex == 0)
    {
        return SamplePointShadowPCF_BoxForMap(fragPos, lightPos, farPlane, u_PointShadowMap0, bias);
    }
    return SamplePointShadowPCF_BoxForMap(fragPos, lightPos, farPlane, u_PointShadowMap1, bias);
}

float SamplePointShadowPCF_PoissonForMap(
    vec3 fragPos,
    vec3 lightPos,
    float farPlane,
    samplerCube shadowMap,
    float bias)
{
    vec3 fragToLight = fragPos - lightPos;
    float currentDepth = length(fragToLight) / farPlane;
    vec3 dir = normalize(fragToLight);

    vec3 tangent;
    vec3 bitangent;
    BuildPointShadowBasis(dir, tangent, bitangent);

    float angle = Hash12(vec2(dir.x + dir.z, dir.y - dir.z)) * 6.2831853;
    float shadow = 0.0;
    for(int i = 0; i < kPoissonSampleCount; ++i)
    {
        vec2 disk = Rotate2D(kPoissonDisk[i], angle);
        vec3 sampleDir = normalize(dir + (tangent * disk.x + bitangent * disk.y) * kPointPoissonRadius);
        float sampledDepth = texture(shadowMap, sampleDir).r;
        shadow += (currentDepth - bias > sampledDepth) ? 1.0 : 0.0;
    }

    return shadow / float(kPoissonSampleCount);
}

float SamplePointShadowPCF_Poisson(vec3 fragPos, vec3 lightPos, float farPlane, int shadowIndex, float bias)
{
    if (shadowIndex == 0)
    {
        return SamplePointShadowPCF_PoissonForMap(fragPos, lightPos, farPlane, u_PointShadowMap0, bias);
    }
    return SamplePointShadowPCF_PoissonForMap(fragPos, lightPos, farPlane, u_PointShadowMap1, bias);
}

float SamplePointShadowPCF_PoissonPCSSForMap(
    vec3 fragPos,
    vec3 lightPos,
    float farPlane,
    samplerCube shadowMap,
    float bias)
{
    vec3 fragToLight = fragPos - lightPos;
    float currentDepth = length(fragToLight) / farPlane;
    vec3 dir = normalize(fragToLight);

    vec3 tangent;
    vec3 bitangent;
    BuildPointShadowBasis(dir, tangent, bitangent);

    float angle = Hash12(vec2(dir.x + dir.z, dir.y - dir.z)) * 6.2831853;
    float filterRadius = clamp(kPointPoissonRadius + currentDepth * kPointPcssScale,
                               kPointPoissonRadius,
                               kPointPcssMaxRadius);

    float shadow = 0.0;
    for(int i = 0; i < kPoissonSampleCount; ++i)
    {
        vec2 disk = Rotate2D(kPoissonDisk[i], angle);
        vec3 sampleDir = normalize(dir + (tangent * disk.x + bitangent * disk.y) * filterRadius);
        float sampledDepth = texture(shadowMap, sampleDir).r;
        shadow += (currentDepth - bias > sampledDepth) ? 1.0 : 0.0;
    }

    return shadow / float(kPoissonSampleCount);
}

float SamplePointShadowPCF_PoissonPCSS(vec3 fragPos, vec3 lightPos, float farPlane, int shadowIndex, float bias)
{
    if (shadowIndex == 0)
    {
        return SamplePointShadowPCF_PoissonPCSSForMap(fragPos, lightPos, farPlane, u_PointShadowMap0, bias);
    }
    return SamplePointShadowPCF_PoissonPCSSForMap(fragPos, lightPos, farPlane, u_PointShadowMap1, bias);
}

vec3 GetCascadeDebugColor(int cascadeIndex)
{
    if(cascadeIndex == 0) return vec3(1.0, 0.0, 0.0); // Red for cascade 0
    else if(cascadeIndex == 1) return vec3(0.0, 1.0, 0.0); // Green for cascade 1
    else if(cascadeIndex == 2) return vec3(0.0, 0.0, 1.0); // Blue for cascade 2
    else if(cascadeIndex == 3) return vec3(1.0, 1.0, 0.0); // Yellow for cascade 3
    else return vec3(1.0); // White for out of range
}
float ComputeDirectionalShadowFactor(vec3 normal, vec3 fragPos, vec4 fragPosViewSpace)
{
    vec3 lightDir = normalize(-DirectionalLight.Direction.xyz);
    vec3 N = normalize(normal);
    float ndotl = max(dot(N, lightDir), 0.0);
    float viewDepth = -fragPosViewSpace.z;
    int cascadeIndex = SelectDirectionalCascadeIndex(viewDepth);
    // Receiver bias: constant + slope, scaled by cascade (farther cascades have coarser depth).
    float cascadeScale = 1.0 + float(cascadeIndex) * 0.75;
    float bias = (0.0015 + 0.02 * (1.0 - ndotl)) * cascadeScale;
    // Prefer geometric-ish offset along the light direction for large flat receivers.
    vec3 samplePos = fragPos + lightDir * (0.02 * cascadeScale) + N * 0.01;
    vec4 cascadeLightSpacePos = DirLightViewProj[cascadeIndex] * vec4(samplePos, 1.0);
    return SampleDirShadowPCF(cascadeLightSpacePos, float(cascadeIndex), bias);
}

float ComputeMaterialSceneShadowVisibility(vec3 normal, vec3 fragPos, vec4 fragPosViewSpace)
{
    float visibility = 1.0;
    int dirShadowIndex = MinEngineShadowMapSlot(DirectionalLight.Params.w);
    if (length(DirectionalLight.Direction.xyz) > 0.001 && dirShadowIndex >= 0)
    {
        visibility *= (1.0 - ComputeDirectionalShadowFactor(normal, fragPos, fragPosViewSpace));
    }
    for (uint i = 0u; i < PointLightsCount && i < 16u; ++i)
    {
        int shadowIndex = MinEngineShadowMapSlot(PointLights[i].Params.w);
        if (shadowIndex < 0 || shadowIndex >= MAX_POINT_SHADOW_MAPS)
        {
            continue;
        }
        vec3 lightDir = normalize(PointLights[i].Position.xyz - fragPos);
        float ndotl = max(dot(normalize(normal), lightDir), 0.0);
        float bias = max(0.002, 0.01 * (1.0 - ndotl));
        float shadow = SamplePointShadowPCF(fragPos, PointLights[i].Position.xyz, PointLights[i].Params.z, shadowIndex, bias);
        visibility *= (1.0 - shadow);
    }
    for (uint i = 0u; i < SpotLightsCount && i < 16u; ++i)
    {
        int shadowIndex = MinEngineShadowMapSlot(SpotLights[i].Params.w);
        if (shadowIndex < 0 || shadowIndex >= MAX_SPOT_SHADOW_MAPS)
        {
            continue;
        }
        vec3 lightDir = normalize(SpotLights[i].Position.xyz - fragPos);
        float ndotl = max(dot(normalize(normal), lightDir), 0.0);
        float bias = max(0.0005, 0.005 * (1.0 - ndotl));
        vec4 fragPosLightSpace = SpotLightViewProj[shadowIndex] * vec4(fragPos, 1.0);
        float shadow = SampleSpotShadowPCF(fragPosLightSpace, shadowIndex, bias);
        visibility *= (1.0 - shadow);
    }
    return clamp(visibility, 0.0, 1.0);
}

#endif // MINENGINE_MATERIAL_SCENE_SHADOWS_GLSLINC
