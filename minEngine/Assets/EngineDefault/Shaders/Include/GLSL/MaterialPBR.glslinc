// Graph-material Cook-Torrance GGX (metallic-roughness). Direct lights; IBL in MaterialIBL.glslinc.
#ifndef MINENGINE_MATERIAL_PBR_GLSLINC
#define MINENGINE_MATERIAL_PBR_GLSLINC

// Requires MaterialSceneShadows.glslinc included earlier in the same translation unit.

layout (std140, set = 0, binding = 0) uniform PerFrameData
{
    mat4 View;
    mat4 Proj;
    mat4 ViewProj;
    vec4 CameraPos;
};

const float kMaterialPBRPi = 3.14159265359;

float MaterialPBRDistributionGGX(vec3 N, vec3 H, float roughness)
{
    float a = roughness * roughness;
    float a2 = a * a;
    float NdotH = max(dot(N, H), 0.0);
    float NdotH2 = NdotH * NdotH;
    float numerator = a2;
    float denominator = (NdotH2 * (a2 - 1.0) + 1.0);
    denominator = kMaterialPBRPi * denominator * denominator;
    return numerator / max(denominator, 0.0001);
}

float MaterialPBRGeometrySchlickGGX(float NdotX, float roughness)
{
    float r = roughness + 1.0;
    float k = (r * r) / 8.0;
    float numerator = NdotX;
    float denominator = NdotX * (1.0 - k) + k;
    return numerator / max(denominator, 0.000001);
}

float MaterialPBRGeometrySmith(vec3 N, vec3 V, vec3 L, float roughness)
{
    float NdotV = max(dot(N, V), 0.0);
    float NdotL = max(dot(N, L), 0.0);
    float ggxView = MaterialPBRGeometrySchlickGGX(NdotV, roughness);
    float ggxLight = MaterialPBRGeometrySchlickGGX(NdotL, roughness);
    return ggxView * ggxLight;
}

vec3 MaterialPBRFresnelSchlick(float cosTheta, vec3 F0)
{
    return F0 + (1.0 - F0) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
}

vec3 MaterialPBRDirectRadiance(
    vec3 N,
    vec3 V,
    vec3 L,
    vec3 lightColor,
    vec3 albedo,
    float metallic,
    float roughness)
{
    vec3 H = normalize(V + L);
    float NdotL = max(dot(N, L), 0.0);
    if (NdotL <= 0.0)
    {
        return vec3(0.0);
    }

    vec3 F0 = vec3(0.04);
    F0 = mix(F0, albedo, metallic);

    float NDF = MaterialPBRDistributionGGX(N, H, roughness);
    float G = MaterialPBRGeometrySmith(N, V, L, roughness);
    vec3 F = MaterialPBRFresnelSchlick(max(dot(H, V), 0.0), F0);

    vec3 numerator = NDF * G * F;
    float denominator = 4.0 * max(dot(N, V), 0.0) * NdotL + 0.0001;
    vec3 specular = numerator / denominator;

    vec3 kS = F;
    vec3 kD = vec3(1.0) - kS;
    kD *= 1.0 - metallic;

    return (kD * albedo / kMaterialPBRPi + specular) * NdotL * lightColor;
}

vec3 CalcDirLightPBR(
    DirectionalLightData light,
    vec3 normal,
    vec3 fragPos,
    vec3 viewDir,
    vec4 fragPosViewSpace,
    vec3 albedo,
    float metallic,
    float roughness)
{
    vec3 N = normalize(normal);
    vec3 V = normalize(viewDir);
    vec3 lightDir = normalize(-light.Direction.xyz);
    vec3 lightColor = light.Color.rgb * light.Color.w;

    float ndotl = max(dot(N, lightDir), 0.0);
    float bias = max(0.0005, 0.005 * (1.0 - ndotl));

    float shadow = 0.0;
    if (MinEngineShadowMapSlot(light.Params.w) >= 0)
    {
        float viewDepth = -fragPosViewSpace.z;
        int cascadeIndex = 3;
        for (int i = 0; i < 4; i++)
        {
            if (viewDepth < FarPlanes[i])
            {
                cascadeIndex = i;
                break;
            }
        }
        vec4 cascadeLightSpacePos = DirLightViewProj[cascadeIndex] * vec4(fragPos, 1.0);
        shadow = SampleDirShadowPCF(cascadeLightSpacePos, cascadeIndex, bias);
    }

    vec3 radiance = MaterialPBRDirectRadiance(N, V, lightDir, lightColor, albedo, metallic, roughness);
    return radiance * (1.0 - shadow);
}

vec3 CalcPointLightPBR(
    PointLightData light,
    vec3 normal,
    vec3 fragPos,
    vec3 viewDir,
    int lightIndex,
    vec3 albedo,
    float metallic,
    float roughness)
{
    vec3 N = normalize(normal);
    vec3 V = normalize(viewDir);
    vec3 lightDir = normalize(light.Position.xyz - fragPos);
    vec3 lightColor = light.Color.rgb * light.Color.w;

    float shadow = 0.0;
    int shadowIndex = MinEngineShadowMapSlot(light.Params.w);
    if (shadowIndex >= 0 && shadowIndex < MAX_POINT_SHADOW_MAPS)
    {
        float ndotl = max(dot(N, lightDir), 0.0);
        float bias = max(0.002, 0.01 * (1.0 - ndotl));
        shadow = SamplePointShadowPCF(fragPos, light.Position.xyz, light.Params.z, shadowIndex, bias);
    }

    vec3 radiance = MaterialPBRDirectRadiance(N, V, lightDir, lightColor, albedo, metallic, roughness);
    return radiance * (1.0 - shadow);
}

vec3 CalcSpotLightPBR(
    SpotLightData light,
    vec3 normal,
    vec3 fragPos,
    vec3 viewDir,
    int lightIndex,
    vec3 albedo,
    float metallic,
    float roughness)
{
    vec3 N = normalize(normal);
    vec3 V = normalize(viewDir);
    vec3 lightDir = normalize(light.Position.xyz - fragPos);
    vec3 lightColor = light.Color.rgb * light.Color.w;

    float theta = dot(lightDir, normalize(-light.Direction.xyz));
    float innerCos = cos(radians(light.Params.x));
    float outerCos = cos(radians(light.Params.y));
    float epsilon = innerCos - outerCos;
    float intensity = clamp((theta - outerCos) / epsilon, 0.0, 1.0);
    lightColor *= intensity;

    float shadow = 0.0;
    int shadowIndex = MinEngineShadowMapSlot(light.Params.w);
    if (shadowIndex >= 0 && shadowIndex < MAX_SPOT_SHADOW_MAPS)
    {
        float ndotl = max(dot(N, lightDir), 0.0);
        float bias = max(0.0005, 0.005 * (1.0 - ndotl));
        vec4 fragPosLightSpace = SpotLightViewProj[shadowIndex] * vec4(fragPos, 1.0);
        shadow = SampleSpotShadowPCF(fragPosLightSpace, shadowIndex, bias);
    }

    vec3 radiance = MaterialPBRDirectRadiance(N, V, lightDir, lightColor, albedo, metallic, roughness);
    return radiance * (1.0 - shadow);
}

#endif // MINENGINE_MATERIAL_PBR_GLSLINC
