    // Relies on skinMatrix / skinnedPosition from MeshVertexSkinnedPosition.glslinc
    // (inserted before this block in the vertex template).
    mat3 skinMatrix3 = mat3(skinMatrix);
    v_WorldFragPos = vec3(u_Model * skinnedPosition);
    v_WorldNormal = mat3(transpose(inverse(u_Model))) * (skinMatrix3 * a_Normal);
    v_WorldTangent = mat3(u_Model) * (skinMatrix3 * a_Tangent.xyz);
    v_TangentSign = a_Tangent.w;
    v_FragPosViewSpace = View * vec4(v_WorldFragPos, 1.0);
